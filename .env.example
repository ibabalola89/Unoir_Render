# Shopify (set by `shopify app dev` / your deploy)
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SHOPIFY_APP_URL=
SCOPES=read_products,write_products
# Optional: custom dev store domain (rarely needed)
# SHOP_CUSTOM_DOMAIN=

# Database (SQLite for dev; switch to Postgres for prod)
# DATABASE_URL=file:./prisma/dev.sqlite

# Background-removal worker
REMOVE_BG_API_KEY=
REDIS_URL=redis://localhost:6379
WORKER_CONCURRENCY=4

# Object storage (S3-compatible: AWS S3, R2, MinIO, etc.)
STORAGE_BUCKET=
STORAGE_REGION=auto
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
# Set for non-AWS providers (R2, MinIO, etc.)
STORAGE_ENDPOINT=
# Optional: public base URL for processed image bytes. If set, used instead of
# 15-minute presigned URLs (recommended for the publish path so Shopify's
# async media ingest can fetch the image whenever it's ready).
STORAGE_PUBLIC_BASE_URL=
