{
  "name": "app",
  "private": true,
  "scripts": {
    "build": "remix vite:build",
    "dev": "shopify app dev",
    "config:link": "shopify app config link",
    "generate": "shopify app generate",
    "deploy": "shopify app deploy",
    "deploy:production": "node scripts/check-production-config.mjs && shopify app deploy --config production",
    "check:production-config": "node scripts/check-production-config.mjs",
    "check:production-env": "node scripts/check-production-env.mjs",
    "check:production-dns": "node scripts/check-production-dns.mjs",
    "check:production-smoke": "node scripts/check-production-smoke.mjs",
    "check:brand-assets": "node scripts/check-brand-assets.mjs",
    "seed:visual-qa": "node scripts/seed-visual-qa.mjs",
    "config:use": "shopify app config use",
    "env": "shopify app env",
    "start": "remix-serve ./build/server/index.js",
    "docker-start": "npm run setup:production && npm run start",
    "setup": "prisma generate && prisma migrate deploy",
    "setup:production": "npm run prisma:generate:production && prisma migrate deploy --schema prisma/production/schema.prisma",
    "prisma:generate:production": "node scripts/prisma-generate-production.mjs",
    "prisma:migrate:production": "prisma migrate deploy --schema prisma/production/schema.prisma",
    "lint": "eslint --cache --cache-location ./node_modules/.cache/eslint .",
    "shopify": "shopify",
    "prisma": "prisma",
    "graphql-codegen": "graphql-codegen",
    "vite": "vite",
    "worker": "tsx lib/queue/worker.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:public": "playwright test tests/e2e/public.spec.ts"
  },
  "type": "module",
  "engines": {
    "node": ">=20.19 <22 || >=22.12"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1039.0",
    "@aws-sdk/s3-request-presigner": "^3.1039.0",
    "@prisma/client": "^6.2.1",
    "@remix-run/dev": "^2.16.1",
    "@remix-run/fs-routes": "^2.16.1",
    "@remix-run/node": "^2.16.1",
    "@remix-run/react": "^2.16.1",
    "@remix-run/serve": "^2.16.1",
    "@shopify/app-bridge-react": "^4.1.6",
    "@shopify/polaris": "^12.0.0",
    "@shopify/shopify-app-remix": "^4.2.0",
    "@shopify/shopify-app-session-storage-prisma": "^9.0.0",
    "bullmq": "^5.76.4",
    "dotenv": "^17.4.2",
    "ioredis": "^5.10.1",
    "isbot": "^5.1.0",
    "prisma": "^6.2.1",
    "react": "^18.2.0",
    "react-compare-slider": "^4.0.0",
    "react-dom": "^18.2.0",
    "tsx": "^4.21.0",
    "vite-tsconfig-paths": "^5.0.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@remix-run/eslint-config": "^2.16.1",
    "@remix-run/route-config": "^2.16.1",
    "@shopify/api-codegen-preset": "^1.1.1",
    "@types/eslint": "^9.6.1",
    "@types/node": "^22.2.0",
    "@types/react": "^18.2.31",
    "@types/react-dom": "^18.2.14",
    "@vitest/coverage-v8": "^4.1.5",
    "eslint": "^8.42.0",
    "eslint-config-prettier": "^10.0.1",
    "prettier": "^3.2.4",
    "typescript": "^5.2.2",
    "vite": "^6.2.2",
    "vitest": "^4.1.5"
  },
  "trustedDependencies": [
    "@shopify/plugin-cloudflare"
  ],
  "resolutions": {
    "@graphql-tools/url-loader": "8.0.16",
    "@graphql-codegen/client-preset": "4.7.0",
    "@graphql-codegen/typescript-operations": "4.5.0",
    "minimatch": "9.0.5",
    "vite": "^6.2.2"
  },
  "overrides": {
    "@graphql-tools/url-loader": "8.0.16",
    "@graphql-codegen/client-preset": "4.7.0",
    "@graphql-codegen/typescript-operations": "4.5.0",
    "minimatch": "9.0.5",
    "vite": "^6.2.2"
  }
}